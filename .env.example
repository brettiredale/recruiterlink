# Copy to .env.local for local work. Real values live in Vercel.
# Never put real keys in this file or anywhere else in the repository.

# Supabase project "RecruiterLink" (London). Both values are safe to expose to browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set to "true" only on the Vercel Production environment, at launch.
# Anything else keeps search engines and AI crawlers out.
SITE_INDEXABLE=

# Supabase secret key (Settings > API keys > Secret keys in Supabase).
# SERVER ONLY: never give it a NEXT_PUBLIC_ name. Needed for agency sign-in
# emails, logo uploads and (later) recording payments.
SUPABASE_SECRET_KEY=

# Resend API key, for every email the site sends.
RESEND_API_KEY=
